# ==========================================
# FieldQuest Environment Configuration Example
# ==========================================

# Backend API Configuration
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# AI Inference Provider
# Supported options: 'ollama' | 'demo'
AI_PROVIDER=demo

# Ollama Configuration (when AI_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
# Request timeout in milliseconds (default 45000ms for local LLM generation)
OLLAMA_TIMEOUT_MS=45000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30

# Web Frontend Configuration (apps/web/.env)
VITE_API_BASE_URL=http://localhost:4000
