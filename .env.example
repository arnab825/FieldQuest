# ==========================================
# FieldQuest Environment Configuration Example
# ==========================================

# Backend API Configuration
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# AI Inference Provider
# Supported options: 'cloud' | 'ollama' | 'demo'
# Default: 'cloud' (runs production free tier with automatic 3-tier failover)
AI_PROVIDER=cloud

# Production Cloud AI (Optional Free Tier: Google Gemini / Groq Cloud)
# When provided, FieldQuest uses fast production cloud models out-of-the-box.
# You can provide a single model (GEMINI_MODEL) or multiple comma-separated fallback models (GEMINI_MODELS).
# If quotas are exhausted or offline, it automatically fails over to the next model in the chain,
# then secondary cloud, then local Ollama / curated library!
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Fallback models chain (attempted sequentially if first model fails or rate limits):
GEMINI_MODELS=gemini-3.8-flash,gemini-3.1-flash-lite,gemini-flash-latest,gemini-flash-lite-latest

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Fallback models chain for Groq:
GROQ_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant,openai/gpt-oss-120b

CLOUD_PROVIDER=gemini

# Ollama Configuration (when AI_PROVIDER=ollama or as Tier 2 failover)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
# Request timeout in milliseconds (default 45000ms for local LLM generation)
OLLAMA_TIMEOUT_MS=45000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30

# Web Frontend Configuration (apps/web/.env)
VITE_API_BASE_URL=http://localhost:4000
